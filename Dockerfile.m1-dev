# =============================================================================
# Aetheris UI M1 - Ultra-Light Development Environment
# Focus: Python 3.12 + Rust (Native Engine & Tauri Shell)
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Builder - System Headers & Python Packages
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

# System dependencies for compiling Python extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    portaudio19-dev \
    libasound2-dev \
    libsdl2-dev \
    libsdl2-image-dev \
    libsdl2-mixer-dev \
    libsdl2-ttf-dev \
    libgl1-mesa-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --prefix=/install -r requirements.txt

# ---------------------------------------------------------------------------
# Stage 2: Base - Python + Rust
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install Rust & basic tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    git \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.cargo/bin:${PATH}"

# ---------------------------------------------------------------------------
# Stage 3: Runtime - Final Dev Image
# ---------------------------------------------------------------------------
FROM base AS runtime

# UI System dependencies (GTK/WebKit for Tauri shell)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1-mesa-dri \
    libgl1 \
    libegl1 \
    libgles2 \
    xvfb \
    vim \
    libgtk-3-dev \
    libwebkit2gtk-4.1-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-compiled Python packages
COPY --from=builder /install /usr/local

WORKDIR /app
COPY . .

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python3 -c "from core.engine import AetherEngine; print('OK')" || exit 1

# Development Port (Backend API)
EXPOSE 8000

CMD ["python3", "-m", "pytest", "tests/", "-v", "-m", "core"]