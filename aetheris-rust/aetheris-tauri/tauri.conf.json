{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aetheris UI",
  "version": "0.1.0",
  "identifier": "com.aetheris.ui",
  "build": {
    "devUrl": "http://localhost:8080"
  },
  "app": {
    "windows": [
      {
        "title": "Aetheris UI",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "http://localhost:8080"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' http://localhost:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": false,
    "targets": []
  }
}